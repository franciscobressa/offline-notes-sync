{
  "name": "offline-notes-sync",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @offline-notes-sync/core && npm run build -w @offline-notes-sync/api --if-present && npm run build -w @offline-notes-sync/web --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "start:api": "npm run start -w @offline-notes-sync/api",
    "dev:web": "npm run dev -w @offline-notes-sync/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
